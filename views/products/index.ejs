<!DOCTYPE html>
<html>
<head>
    <title>Products</title>
</head>
<body>

<h2>Available Discount Products</h2>

<a href="/profile">Back to Profile</a>
<br><br>

<% if (products.length === 0) { %>
    <p>No products found.</p>
<% } else { %>

    <% products.forEach(product => { %>
        <div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">

            <h3>
                <a href="/products/<%= product.id %>">
                    <%= product.title %>
                </a>
            </h3>

            <% if (product.is_expired === 1) { %>
                <p style="color:red; font-weight:bold;">EXPIRED PRODUCT</p>
            <% } %>

            <% if (product.image) { %>
                <img src="/uploads/<%= product.image %>" width="150">
                <br><br>
            <% } %>

            <p><strong>Market:</strong> <%= product.market_name %></p>
            <p><strong>Location:</strong> <%= product.city %> / <%= product.district %></p>
            <p><strong>Stock:</strong> <%= product.stock %></p>

            <p>
                <strong>Normal Price:</strong>
                <del><%= product.normal_price %> TL</del>
            </p>

            <p>
                <strong>Discounted Price:</strong>
                <%= product.discounted_price %> TL
            </p>

            <p>
                <strong>Expiration Date:</strong>
                <%= product.expiration_date.toISOString().slice(0, 10) %>
            </p>

            <a href="/market/products/edit/<%= product.id %>">Edit</a>
            <br><br>

            <form method="POST" action="/market/products/delete/<%= product.id %>">
                <button type="submit">Delete</button>
            </form>

        </div>
    <% }) %>

<% } %>

</body>
</html>