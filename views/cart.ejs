<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
</head>
<body>

<h2>Shopping Cart</h2>

<a href="/products">Back to Products</a>
<br><br>

<div id="cart-container">

<% if (cartItems.length === 0) { %>

    <p>Your cart is empty.</p>

<% } else { %>

    <% cartItems.forEach(item => { %>

        <div id="cart-item-<%= item.cart_id %>" style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">

            <h3><%= item.title %></h3>

            <% if (item.image) { %>
                <img src="/uploads/<%= item.image %>" width="120">
                <br><br>
            <% } %>

            <p>Price: <%= item.discounted_price %> TL</p>

            <label>Quantity:</label>
            <input 
                type="number" 
                min="1" 
                value="<%= item.quantity %>" 
                id="quantity-<%= item.cart_id %>"
            >

            <button onclick="updateCart(<%= item.cart_id %>)">Update</button>
            <button onclick="removeCartItem(<%= item.cart_id %>)">Remove</button>

            <p>
                Total:
                <span id="item-total-<%= item.cart_id %>"><%= item.total_price %></span>
                TL
            </p>

        </div>

    <% }) %>

    <h3>
        Grand Total:
        <span id="grand-total"><%= grandTotal %></span>
        TL
    </h3>

<% } %>

</div>

<script>
async function updateCart(cartId) {
    const quantity = document.getElementById(`quantity-${cartId}`).value;

    const response = await fetch(`/cart/update/${cartId}`, {
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        body: `quantity=${quantity}`
    });

    const data = await response.json();

    if (data.success) {
        if (quantity < 1) {
            document.getElementById(`cart-item-${cartId}`).remove();
        } else {
            document.getElementById(`item-total-${cartId}`).textContent = data.itemTotal;
        }

        document.getElementById("grand-total").textContent = data.grandTotal;
    }
}

async function removeCartItem(cartId) {
    const response = await fetch(`/cart/remove/${cartId}`, {
        method: "POST"
    });

    const data = await response.json();

    if (data.success) {
        document.getElementById(`cart-item-${cartId}`).remove();
        document.getElementById("grand-total").textContent = data.grandTotal;
    }
}
</script>

</body>
</html>