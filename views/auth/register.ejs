<!DOCTYPE html>
<html>
<head>
    <title>Register</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="auth-wrapper">
<div class="auth-box">

<h2>Register</h2>

<% if (typeof error !== 'undefined') { %>
    <p style="color:red;"><%= error %></p>
<% } %>

<form method="POST" action="/auth/register" onsubmit="return validateForm()">

    <label>Role:</label><br>
    <select name="role" required>
        <option value="consumer" <%= typeof form !== 'undefined' && form.role === 'consumer' ? 'selected' : '' %>>Consumer</option>
        <option value="market" <%= typeof form !== 'undefined' && form.role === 'market' ? 'selected' : '' %>>Market</option>
    </select><br><br>

    <label>Full Name / Market Name:</label><br>
    <input type="text" name="name" value="<%= typeof form !== 'undefined' ? form.name : '' %>" required><br><br>

    <label>Email:</label><br>
    <input type="email" name="email" value="<%= typeof form !== 'undefined' ? form.email : '' %>" required><br><br>

    <label>Password:</label><br>
    <input type="password" name="password" required><br><br>

    <label>City:</label><br>
    <input type="text" name="city" value="<%= typeof form !== 'undefined' ? form.city : '' %>" required><br><br>

    <label>District:</label><br>
    <input type="text" name="district" value="<%= typeof form !== 'undefined' ? form.district : '' %>" required><br><br>

    <p id="val-error" style="color:red;"></p>
    <button type="submit" style="width:100%;">Register</button>

</form>

<p>Already have an account? <a href="/auth/login">Login</a></p>

</div>
</div>

<script>
function validateForm() {
    const error = document.getElementById("val-error");
    const name = document.querySelector('[name="name"]').value.trim();
    const email = document.querySelector('[name="email"]').value.trim();
    const password = document.querySelector('[name="password"]').value;
    const city = document.querySelector('[name="city"]').value.trim();
    const district = document.querySelector('[name="district"]').value.trim();

    if (!name || !email || !password || !city || !district) {
        error.textContent = "Please fill in all fields";
        return false;
    }
    if (password.length < 4) {
        error.textContent = "Password must be at least 4 characters";
        return false;
    }
    return true;
}
</script>

</body>
</html>