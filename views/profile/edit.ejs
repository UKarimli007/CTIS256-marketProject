<!DOCTYPE html>
<html>
<head>
    <title>Edit Profile</title>
    <link rel="stylesheet" href="/style.css">
    <script>
        function validateForm() {
            const error = document.getElementById("val-error");
            const name = document.forms["editForm"]["name"].value.trim();
            const city = document.forms["editForm"]["city"].value.trim();
            const district = document.forms["editForm"]["district"].value.trim();

            if (!name || !city || !district) {
                error.textContent = "All fields must be filled out";
                return false;
            }
            return true;
        }
    </script>
</head>
<body>

<h2>Edit Profile</h2>

<a href="/profile" class="btn btn-outline">Back to Profile</a>
<br><br>

<% if (error) { %>
    <p style="color:red;"><%= error %></p>
<% } %>

<form name="editForm" method="POST" action="/profile/edit" onsubmit="return validateForm()">

    <label>Email:</label><br>
    <input type="email" value="<%= userData.email %>" disabled><br><br>

    <label>Name:</label><br>
    <input 
        type="text" 
        name="name" 
        value="<%= userData.role === 'consumer' ? userData.full_name : userData.market_name %>" 
        required
    ><br><br>

    <label>City:</label><br>
    <input type="text" name="city" value="<%= userData.city %>" required><br><br>

    <label>District:</label><br>
    <input type="text" name="district" value="<%= userData.district %>" required><br><br>

    <p id="val-error" style="color:red;"></p>
    <button type="submit">Update Profile</button>

</form>

</body>
</html>