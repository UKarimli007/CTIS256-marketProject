<!DOCTYPE html>
<html>
<head>
    <title>Profile</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<h2>Profile</h2>

<div class="info-box">
    <p><strong>Email:</strong> <%= userData.email %></p>
    <p><strong>Name:</strong> <%= userData.role === 'consumer' ? userData.full_name : userData.market_name %></p>
    <p><strong>City:</strong> <%= userData.city %></p>
    <p><strong>District:</strong> <%= userData.district %></p>
</div>

<div class="actions">
    <a href="/profile/edit" class="btn">Edit Profile</a>
    <a href="/products" class="btn">View Products</a>
    <a href="/cart" class="btn">Shopping Cart</a>
    <a href="/auth/logout" class="btn btn-danger">Logout</a>
</div>

</body>
</html>
